{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tablify.dev/schemas/tablify.schema.json",
  "title": "Tablify v1 File Format",
  "description": "JSON Schema for .tablify files (formatVersion 1 or 2). See FORMAT_SPEC.md for the authoritative specification.",
  "type": "object",
  "required": [
    "formatVersion",
    "tableId",
    "name",
    "fields",
    "rows",
    "views",
    "syncLink"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "enum": [1, 2],
      "description": "File format version. 1, or 2 when a table has a formula or link field (FORMAT_SPEC §12)."
    },
    "tableId": {
      "type": "string",
      "pattern": "^tbl_[A-Za-z0-9]+$",
      "description": "Unique table identifier with tbl_ prefix."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable table name."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      },
      "description": "Array of field definitions. At least one field required."
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "description": "Array of row objects. May be empty."
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      },
      "description": "Array of view definitions. At least one view required."
    },
    "syncLink": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/syncLink"
        }
      ],
      "description": "Airtable link metadata (P7-04). Null for a local-only table."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fld_[A-Za-z0-9_]+$",
          "description": "Stable field identifier with fld_ prefix."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable field name."
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "long_text",
            "number",
            "currency",
            "percent",
            "duration",
            "rating",
            "checkbox",
            "date",
            "date_time",
            "url",
            "email",
            "phone",
            "single_select",
            "multi_select",
            "attachment",
            "auto_number",
            "created_time",
            "modified_time",
            "formula",
            "link"
          ],
          "description": "Field type. One of 21 supported types. formula and link require formatVersion 2."
        },
        "primary": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the primary field. Exactly one field must be primary."
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectOption"
          },
          "description": "Options for single_select and multi_select fields."
        },
        "formula": {
          "type": "string",
          "description": "formula fields only (v2). The expression. Results are not stored in the file."
        },
        "linkTableId": {
          "type": "string",
          "pattern": "^tbl_[A-Za-z0-9]+$",
          "description": "link fields only (v2). Default target table ID."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether cells must have a non-empty value."
        },
        "unique": {
          "type": "boolean",
          "default": false,
          "description": "Whether values must be unique across rows. Case-sensitive."
        },
        "min": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "Minimum value constraint. Number for numeric types, ISO date string for date types."
        },
        "max": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "Maximum value constraint."
        },
        "regex": {
          "type": [
            "string",
            "null"
          ],
          "description": "Regular expression for text validation."
        },
        "airtable": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fieldAirtable"
            }
          ],
          "description": "Airtable field link (P7-05). Absent or null for a local-only field."
        }
      },
      "additionalProperties": true
    },
    "selectOption": {
      "type": "object",
      "required": [
        "id",
        "name",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^opt_[A-Za-z0-9_]+$",
          "description": "Option identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Option display name."
        },
        "color": {
          "type": "string",
          "enum": [
            "gray",
            "brown",
            "orange",
            "yellow",
            "green",
            "blue",
            "purple",
            "pink",
            "red"
          ],
          "description": "Option color."
        }
      },
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "rev",
        "updatedAt",
        "values",
        "sync"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^row_[A-Za-z0-9]+$",
          "description": "Stable row identifier with row_ prefix."
        },
        "rev": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision counter. Starts at 1, increments by 1 per edit."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 last-modified timestamp."
        },
        "values": {
          "type": "object",
          "description": "Cell values keyed by field ID.",
          "additionalProperties": true
        },
        "sync": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rowSync"
            }
          ],
          "description": "Per-row Airtable sync state (P7-04). Null for a local-only row."
        }
      },
      "additionalProperties": true
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sort",
        "groupBy",
        "hidden",
        "frozenColumns",
        "rowHeight",
        "columnWidths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "View identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "View display name."
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fieldId",
              "direction"
            ],
            "properties": {
              "fieldId": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "additionalProperties": true
          },
          "description": "Sort entries."
        },
        "groupBy": {
          "type": [
            "string",
            "null"
          ],
          "description": "Field ID to group by, or null."
        },
        "hidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of hidden field IDs."
        },
        "frozenColumns": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of frozen columns from the left."
        },
        "rowHeight": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Row height setting."
        },
        "columnWidths": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Map of field ID to column width in pixels."
        },
        "columnOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered list of field IDs defining column display order."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-fatal warnings recorded during view normalization (e.g., unknown field IDs ignored)."
        },
        "search": {
          "type": "string",
          "description": "Global search text persisted with the view (SAD-69). Empty string means no search."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "P2-02 query persisted with the view (SAD-69). null means no query filter."
        }
      },
      "additionalProperties": true
    },
    "fieldAirtable": {
      "type": "object",
      "required": [
        "id",
        "type",
        "readOnly"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fld[A-Za-z0-9]+$",
          "description": "Airtable field ID (fld…). Survives renames."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Airtable field type name at link time."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Shown but never pushed to Airtable."
        }
      },
      "additionalProperties": true
    },
    "rowSync": {
      "type": "object",
      "required": [
        "airtableId",
        "syncedRev",
        "syncedAt",
        "remoteHash"
      ],
      "properties": {
        "airtableId": {
          "type": "string",
          "pattern": "^rec[A-Za-z0-9]+$"
        },
        "syncedRev": {
          "type": "integer",
          "minimum": 0,
          "description": "Row rev at the last successful sync."
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time"
        },
        "remoteHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of normalized remote values."
        },
        "remoteDeleted": {
          "type": "boolean",
          "description": "Record was deleted in Airtable; the row was kept."
        },
        "conflict": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rowSyncConflict"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "rowSyncConflict": {
      "type": "object",
      "required": [
        "kind",
        "decision",
        "localRev",
        "remoteHash",
        "decidedAt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "both_changed",
            "remote_deleted"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "keep_local",
            "keep_remote",
            "keep_both"
          ]
        },
        "localRev": {
          "type": "integer",
          "minimum": 0
        },
        "remoteHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "syncLink": {
      "type": "object",
      "required": [
        "baseId",
        "tableId",
        "tableName",
        "linkedAt",
        "lastSync",
        "records"
      ],
      "properties": {
        "baseId": {
          "type": "string",
          "pattern": "^app[A-Za-z0-9]+$"
        },
        "tableId": {
          "type": "string",
          "pattern": "^tbl[A-Za-z0-9]+$"
        },
        "tableName": {
          "type": "string"
        },
        "linkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSync": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "at",
                "direction",
                "ok",
                "summary"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "link",
                    "pull",
                    "push"
                  ]
                },
                "ok": {
                  "type": "boolean"
                },
                "summary": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "airtableId",
              "remoteHash"
            ],
            "properties": {
              "airtableId": {
                "type": "string",
                "pattern": "^rec[A-Za-z0-9]+$"
              },
              "remoteHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
