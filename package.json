{
  "name": "tablify",
  "version": "0.0.1",
  "description": "Airtable-like tables in .tablify files. Desktop and mobile.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:guard": "bash scripts/check-tabula-guard.sh",
    "check": "npm run lint && npm run test && npm run check:guard && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^1.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.20.0",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "table",
    "airtable"
  ],
  "license": "MIT"
}
